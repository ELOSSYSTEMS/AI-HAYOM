  },
  "paths": {
    "state": "state/state.json",
    "lock": "state/run.lock",
    "research": "output/research",
    "drafts": "output/drafts",
    "alerts": "output/alerts",
    "websiteRepo": "website",
    "websiteEditions": "edition",
    "websiteAssets": "edition"
  },
  "deployment": {
    "githubRepository": "REPLACE_WITH_OWNER/REPOSITORY",
    "githubDefaultBranch": "main",
    "productionDomain": "REPLACE_WITH_DOMAIN"
  },
  "publication": {
    "enabled": false,
    "push": false,
    "verifyProduction": false,
    "verificationTimeoutSeconds": 300
  },
  "inference": {
    "enabled": false,
    "command": ["hermes", "-z"],
    "provider": "REPLACE_WITH_APPROVED_PROVIDER",
    "auth_status_command": ["hermes", "auth", "status", "REPLACE_WITH_APPROVED_PROVIDER"],
    "fixtureOnlyUntilApproved": true
  },
  "telegram": {
    "enabled": false,
    "destination": "REPLACE_WITH_EXISTING_GATEWAY_DESTINATION",
    "allowlistedChatIdEnv": "TELEGRAM_CHAT_ID"
  },
  "editorial": {
    "cartoonCharter": "Embedded in ai_hayom.py as EDITORIAL_CARTOON_CHARTER",
    "minStories": 4,
    "maxStories": 6,
    "minHealthyFeeds": 6,
    "maxResearchItems": 40,
    "freshWindowHours": 24,
    "fallbackWindowHours": 72,
    "maxStoryAgeHours": 168,
    "minFreshStories": 3,
    "maxContextStories": 1,
    "maxResearchItemsPerSource": 2,
    "aiRelevanceKeywords": ["ai", "artificial intelligence", "machine learning", "deep learning", "generative", "gpt", "llm", "language model", "foundation model", "model", "agent", "robotics", "neural", "inference"],
    "priorityKeywords": ["model", "release", "launch", "safety", "regulation", "research"],
    "approvalRequiredForPublish": true
  },
  "schedules": {
    "dailyPreparation": "30 6 * * *",
    "breakingMonitoring": "*/30 8-22 * * *",
    "timezone": "Asia/Jerusalem",
    "active": false
